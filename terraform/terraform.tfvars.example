# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars (it is already excluded via .gitignore).

project_name = "scalable-web-app"
environment  = "prod"
aws_region   = "us-east-1"

vpc_cidr                 = "10.0.0.0/16"
availability_zones       = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs      = ["10.0.0.0/24", "10.0.1.0/24"]
private_app_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
private_db_subnet_cidrs  = ["10.0.20.0/24", "10.0.21.0/24"]

instance_type          = "t3.micro"
asg_min_size           = 2
asg_max_size           = 6
asg_desired_capacity   = 2
target_cpu_utilization = 60

db_engine             = "mysql"
db_engine_version     = "8.0"
db_instance_class     = "db.t3.medium"
db_allocated_storage  = 50
db_name               = "appdb"
db_username           = "admin"
db_password           = "CHANGE-ME-use-a-strong-secret" # better: pull from AWS Secrets Manager

domain_name         = "" # e.g. "example.com" - leave empty to skip Route 53
create_route53_zone = false
alert_email         = "" # e.g. "you@example.com"

acm_certificate_arn = "" # ACM cert ARN in the ALB's region, required for HTTPS listener
key_pair_name       = "" # optional, access is via SSM Session Manager instead
